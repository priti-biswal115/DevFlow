{
  "name": "devflow",
  "displayName": "DevFlow",
  "description": "",
  "version": "0.0.1",
  "engines": {
  "vscode": "^1.134.0"
},
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onView:devflow.mainView",
    "onCommand:devflow.helloWorld"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "devflow.helloWorld",
        "title": "Hello World"
      },
      {
        "command": "devflow.clearChangeHighlights",
        "title": "DevFlow: Clear Change Highlights"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "devflow",
          "title": "DevFlow",
          "icon": "media/icon-activity.svg"
        }
      ]
    },
    "views": {
      "devflow": [
        {
          "id": "devflow.mainView",
          "name": "DevFlow",
          "type": "webview",
          "icon": "media/icon-activity.svg"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "^1.136.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "eslint": "^10.5.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  },
  "dependencies": {
    "axios": "^1.20.0"
  }
}
